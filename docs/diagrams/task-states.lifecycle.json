  "cards": [
    {
      "dot": "cyan",
      "title": "Operator operations",
      "items": [
        "Queue (board, before claim): Next, Boost, Ready an issue with the auto label",
        "Task: Reply, Answers, Park, Resume, Kill, Cancel, Run with a model",
        "Retry clears a provisioning quarantine so the issue can be claimed again",
        "Console writes intent files; the dispatcher drains them at the top of each pass"
      ]
    },
    {
      "dot": "emerald",
      "title": "Transition conditions",
      "items": [
        "Claim (queued, then spec in the same pass): capacity, max_open and usage admission allow it",
        "Spec done: spec.md passes check_spec and the track is valid",
        "Ready: tickets checked, spec folder published; approved: operator approval only",
        "Gate skipped: gate-free track, nothing asked, 0 open questions",
        "Died: a dead gate session respawns plan while unattended rounds remain",
        "Feedback: PR comments, red check or conflict; each CI round counts, past the cap it parks",
        "Park, crash / kill, cancel: from any live stage; the drawn source stage is one example",
        "Resume: back to the stage it parked or crashed in; Kill and PR close are final"
      ]
    },
    {
      "dot": "amber",
      "title": "Waits are flags, not stages",
      "items": [
        "Park keeps the stage and sets park: parked, login, awaiting-ci, awaiting-review or resume-requested",
        "A parked plan gate (grace or rounds used up) frees its E2E slot",
        "Resume queues a wake; capacity and usage admission still decide when it launches"
      ]
    },
    {
      "dot": "slate",
      "title": "Left out",
      "items": [
        "Implement is the representative stage for park, fail and cancel; all live stages do the same",
        "blocked and stalled-on-budget are legacy stages nothing writes any more",
        "Retries of bad signals or failed ticket checks stay inside a stage"
      ]
    }
  ]
