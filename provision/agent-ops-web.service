[Unit]
Description=agent-ops web console (loopback :8481, published via tailscale serve)
After=network-online.target
After=agent-ops-herdr.service
Wants=agent-ops-herdr.service

[Service]
Environment=AGENT_OPS_STATE_DIR=%h/agent-ops-state
EnvironmentFile=%h/agent-ops-state/op-token.env
ExecStart=/usr/bin/env OP_SERVICE_ACCOUNT_TOKEN=${OP_SERVICE_ACCOUNT_AGENT_OPS_TOKEN} \
  op run --env-file=%h/agent-ops/provision/op.env.tpl -- \
  %h/agent-ops/.venv/bin/python -m web --config %h/agent-ops-state/targets.yaml
WorkingDirectory=%h/agent-ops
Restart=on-failure
RestartSec=5
# uvicorn drains live streams for at most 5 s (timeout_graceful_shutdown in
# web/__main__.py); anything slower is a hang.  The default 90 s stop timeout
# turned every deploy restart into a ~90 s 502 window (2026-07-30).
TimeoutStopSec=10

[Install]
WantedBy=default.target
