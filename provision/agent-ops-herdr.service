[Unit]
Description=agent-ops herdr server (the session layer: one tab per task)
# The dispatcher, web console, waitd and the triage runner all resolve
# sessions through this server's socket (~/.config/herdr/herdr.sock).
After=network-online.target

[Service]
# Every session pane, its shell and its `podman run … claude` are children
# of this server, so they live in THIS unit's cgroup: stopping or restarting
# agent-ops-herdr.service kills every live session — the same blast radius
# as killing the tmux server used to have. Nothing resumes those tasks:
# on restart herdr restores its saved layout (~/.config/herdr/session.json)
# and every task-* tab comes back as a bare shell with no container behind
# it, which the dispatcher reads as dead (liveness = busy shell; a bare
# shell is not busy) → the crash path reports each one and moves the task
# to FAILED. So a restart here costs one Failed card per live task, and
# recovery is the operator's (see provision/README.md). Prefer `herdr
# update` (in-place handoff) over a unit restart for upgrades.
ExecStart=%h/.local/bin/herdr server
Restart=always
RestartSec=2
# Panes need a sane locale/terminal type for claude's TUI; the user
# manager's environment has neither.
Environment=TERM=xterm-256color
Environment=LANG=C.UTF-8

[Install]
WantedBy=default.target
