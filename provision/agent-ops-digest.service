[Unit]
Description=agent-ops daily digest
After=network-online.target

[Service]
Type=oneshot
User=agent
WorkingDirectory=/home/agent/agent-ops
Environment=AGENT_OPS_STATE_DIR=/home/agent/agent-ops-state
EnvironmentFile=/home/agent/agent-ops-state/op-token.env
ExecStart=/usr/local/bin/op run --env-file=/home/agent/agent-ops/provision/op.env.tpl -- \
  /home/agent/agent-ops/.venv/bin/python -m dispatcher.main --config /home/agent/agent-ops/targets.yaml --digest
