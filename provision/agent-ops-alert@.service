[Unit]
Description=agent-ops failure alert for %i

[Service]
Type=oneshot
WorkingDirectory=%h/agent-ops
# Same secret plumbing as agent-ops-dispatcher.service: op resolves
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID; the token file defines
# OP_SERVICE_ACCOUNT_AGENT_OPS_TOKEN and op only accepts
# OP_SERVICE_ACCOUNT_TOKEN, so env remaps it.
EnvironmentFile=%h/agent-ops-state/op-token.env
ExecStart=/usr/bin/env OP_SERVICE_ACCOUNT_TOKEN=${OP_SERVICE_ACCOUNT_AGENT_OPS_TOKEN} \
  op run --env-file=%h/agent-ops/provision/op.env.tpl -- \
  %h/agent-ops/.venv/bin/python -m telegram.alert %i
