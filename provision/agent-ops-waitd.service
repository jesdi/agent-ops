[Unit]
Description=agent-ops waitd (stop-hook ping -> Telegram)
# Serves $AGENT_OPS_STATE_DIR/wait/wait.sock — the wait dir is what session
# containers bind-mount so their Stop hooks can reach it. (Comment doubles
# as a unit-file change so update.sh restarts waitd onto the new path.)
After=network-online.target
After=agent-ops-herdr.service
Wants=agent-ops-herdr.service

[Service]
Environment=AGENT_OPS_STATE_DIR=%h/agent-ops-state
EnvironmentFile=%h/agent-ops-state/op-token.env
ExecStart=/usr/bin/env OP_SERVICE_ACCOUNT_TOKEN=${OP_SERVICE_ACCOUNT_AGENT_OPS_TOKEN} \
  op run --env-file=%h/agent-ops/provision/op.env.tpl -- \
  %h/agent-ops/.venv/bin/python -m dispatcher.waitd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
