[Unit]
Description=agent-ops dispatcher pass
After=network-online.target

[Service]
Type=oneshot
# The pass spawns detached tmux servers hosting the per-task Claude
# sessions; they must OUTLIVE the pass. The default KillMode
# (control-group) reaps every process left in the unit's cgroup the
# moment the oneshot deactivates — observed on task #192's first-ever
# spawn: the tmux server died within seconds of "Finished ... dispatcher
# pass". KillMode=process only ever kills ExecStart's main process.
KillMode=process
WorkingDirectory=%h/agent-ops
Environment=AGENT_OPS_STATE_DIR=%h/agent-ops-state
# op resolves TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID from the agent-ops
# vault. The token file defines OP_SERVICE_ACCOUNT_AGENT_OPS_TOKEN; the op
# CLI only accepts OP_SERVICE_ACCOUNT_TOKEN, so env remaps it here.
EnvironmentFile=%h/agent-ops-state/op-token.env
# Long-lived claude token for the budget check's usage-API call; optional
# ('-') so boxes without it fall back to the claude-home store.
EnvironmentFile=-%h/agent-ops-state/claude-token.env
ExecStart=/usr/bin/env OP_SERVICE_ACCOUNT_TOKEN=${OP_SERVICE_ACCOUNT_AGENT_OPS_TOKEN} \
  op run --env-file=%h/agent-ops/provision/op.env.tpl -- \
  %h/agent-ops/.venv/bin/python -m dispatcher.main --config %h/agent-ops-state/targets.yaml
