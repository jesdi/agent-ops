[Unit]
Description=agent-ops dispatcher pass
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/agent-ops
Environment=AGENT_OPS_STATE_DIR=%h/agent-ops-state
# op resolves TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID from the Development
# vault via the service-account token in OP_SERVICE_ACCOUNT_TOKEN.
EnvironmentFile=%h/agent-ops-state/op-token.env
ExecStart=/usr/local/bin/op run --env-file=%h/agent-ops/provision/op.env.tpl -- \
  %h/agent-ops/.venv/bin/python -m dispatcher.main --config %h/agent-ops-state/targets.yaml
