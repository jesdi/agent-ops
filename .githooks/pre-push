#!/usr/bin/env bash
# agent-ops pre-push hook, enabled by scripts/setup.sh (core.hooksPath).
# Refuses every pushed commit that no known remote ref has yet when it has a
# Co-authored-by trailer or, with commit.gpgsign on, no good signature (%G? G
# or U). A deliberate push bypasses it with `git push --no-verify`.
set -euo pipefail
status=-  # not checked: gpg runs only when commit.gpgsign is on
[[ $(git config --type=bool commit.gpgsign || echo false) == true ]] && status=%G?
zero='^0+$'
bad=0
while read -r _ local_sha _ remote_sha; do
  [[ $local_sha =~ $zero ]] && continue  # a deleted ref
  known=(--not --remotes)                # $1 may be a URL: exclude every remote ref
  [[ $remote_sha =~ $zero ]] || known+=("$remote_sha")
  # Into a variable, not a process substitution: a failing git log stops the push.
  rows=$(git log --format="%h $status %(trailers:key=Co-authored-by,valueonly,separator=;)" "$local_sha" "${known[@]}")
  while read -r sha sig trailer; do
    [[ -n $sha ]] || continue
    if [[ $sig != - && $sig != G && $sig != U ]]; then
      echo "pre-push: $sha has no good signature ($sig)" >&2; bad=1
    fi
    if [[ -n $trailer ]]; then
      echo "pre-push: $sha has a Co-authored-by trailer" >&2; bad=1
    fi
  done <<<"$rows"
done
exit $bad
